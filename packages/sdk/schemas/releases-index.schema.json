{
  "$id": "https://cs-sdlc.dev/schema/v1/releases-index.json",
  "$ref": "#/definitions/releases-index",
  "definitions": {
    "releases-index": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+(\\.[a-zA-Z0-9]+)*)?(\\+[a-zA-Z0-9]+(\\.[a-zA-Z0-9]+)*)?$"
              },
              "title": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "version",
              "date",
              "path"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
