{
  "$id": "https://cs-sdlc.dev/schema/v1/decision-frontmatter.json",
  "$ref": "#/definitions/decision-frontmatter",
  "definitions": {
    "decision-frontmatter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "proposed",
                "accepted",
                "deprecated",
                "superseded"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersededBy": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          }
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "date"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
