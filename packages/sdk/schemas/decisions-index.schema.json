{
  "$id": "https://cs-sdlc.dev/schema/v1/decisions-index.json",
  "$ref": "#/definitions/decisions-index",
  "definitions": {
    "decisions-index": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^\\d{3}$"
              },
              "slug": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "status": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "proposed",
                      "accepted",
                      "deprecated",
                      "superseded"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "supersedes": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{3}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "slug",
              "title",
              "status",
              "date",
              "path"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
