{
  "name": "@syncfusion/cs-sdlc",
  "version": "0.1.0",
  "description": "TypeScript SDK for the .sdlc/ file format specification",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "schemas": "tsx scripts/generate-schemas.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@syncfusion/tsconfig": "workspace:*",
    "@types/node": "^26.1.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "keywords": [
    "sdlc",
    "ai-context",
    "project-management",
    "developer-tools"
  ],
  "license": "MIT"
}
