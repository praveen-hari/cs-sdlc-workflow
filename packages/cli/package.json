{
  "name": "@syncfusion/cs-sdlc-cli",
  "version": "0.1.0",
  "description": "CLI tool for the .sdlc/ file format specification",
  "type": "module",
  "bin": {
    "cs-sdlc": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@syncfusion/cs-sdlc": "workspace:*",
    "citty": "^0.1.6",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@syncfusion/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
