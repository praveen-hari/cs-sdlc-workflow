{
  "name": "@syncfusion/cs-sdlc-extension",
  "displayName": "SDLC Workflow",
  "description": "AI-powered SDLC project management — track work, manage context, review plans, ship with confidence",
  "version": "0.1.0",
  "publisher": "syncfusion",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "sdlc",
    "workflow",
    "project-management",
    "ai",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "media/sdlc-icon.png",
  "contributes": {
    "commands": [
      {
        "command": "sdlc-workflow.init",
        "title": "Initialize SDLC Tracking",
        "category": "SDLC Workflow",
        "icon": "$(rocket)"
      },
      {
        "command": "sdlc-workflow.start",
        "title": "Start New Work Item",
        "category": "SDLC Workflow",
        "icon": "$(add)"
      },
      {
        "command": "sdlc-workflow.status",
        "title": "Show Project Status",
        "category": "SDLC Workflow",
        "icon": "$(info)"
      },
      {
        "command": "sdlc-workflow.done",
        "title": "Complete Active Work Item",
        "category": "SDLC Workflow",
        "icon": "$(check)"
      },
      {
        "command": "sdlc-workflow.openDashboard",
        "title": "Open Dashboard",
        "category": "SDLC Workflow",
        "icon": "$(dashboard)"
      },
      {
        "command": "sdlc-workflow.openInChat",
        "title": "Open in Chat",
        "category": "SDLC Workflow",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sdlc-workflow.sync",
        "title": "Sync SDLC Data",
        "category": "SDLC Workflow",
        "icon": "$(sync)"
      },
      {
        "command": "sdlc-workflow.snapshot",
        "title": "Take Snapshot",
        "category": "SDLC Workflow",
        "icon": "$(device-camera)"
      }
    ],
    "languageModelTools": [
      {
        "name": "sdlc-workflow_initProject",
        "displayName": "Initialize SDLC Project",
        "modelDescription": "Creates a new .sdlc/ directory with manifest.json, context templates, and empty indexes. Use when the user wants to set up SDLC tracking for their workspace. This is a one-time operation — it will fail if .sdlc/ already exists.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sdlcInit",
        "icon": "$(rocket)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "description": "Project name" },
            "description": { "type": "string", "description": "One-line project description" }
          },
          "required": ["name"]
        }
      },
      {
        "name": "sdlc-workflow_getProjectStatus",
        "displayName": "Get SDLC Project Status",
        "modelDescription": "Returns the current SDLC project status including project name, tech stack, modules, active work items, recent completions, counters, and health metrics from manifest.json and indexes. Use when the user asks about project status or overview. For reading individual files like architecture.md or conventions.md, read them directly instead.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sdlcStatus",
        "icon": "$(info)",
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "sdlc-workflow_createWorkItem",
        "displayName": "Create SDLC Work Item",
        "modelDescription": "Creates a new SDLC work item with proper ID generation, brief.md template, plan.md template, and updates the work index and manifest counters atomically. Use when the user wants to start working on a new feature, bug fix, or task. For reading or editing existing work items, read/edit the files in .sdlc/work/active/{id}/ directly.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sdlcCreate",
        "icon": "$(add)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "description": "Description of the work item" },
            "type": { "type": "string", "enum": ["feature", "bug", "refactor", "performance", "security", "docs", "tech-debt", "infrastructure"], "description": "Type of work. Default: feature" },
            "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"], "description": "Priority level. Default: medium" },
            "modules": { "type": "array", "items": { "type": "string" }, "description": "Module IDs this work affects" }
          },
          "required": ["title"]
        }
      },
      {
        "name": "sdlc-workflow_completeWorkItem",
        "displayName": "Complete SDLC Work Item",
        "modelDescription": "Marks an active SDLC work item as completed — archives it from work/active/ to work/archive/, updates the work index, and increments manifest counters atomically. Use when the user says they are done with a task or when all acceptance criteria have been met.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sdlcComplete",
        "icon": "$(check)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "The work item ID to complete" }
          },
          "required": ["id"]
        }
      },
      {
        "name": "sdlc-workflow_logDecision",
        "displayName": "Log SDLC Decision",
        "modelDescription": "Creates an architectural decision record (ADR) with auto-incrementing ID, proper file naming, and atomic index update. Use when the user makes a significant technical decision or chooses between alternatives.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sdlcDecision",
        "icon": "$(law)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "description": "Decision title" },
            "context": { "type": "string", "description": "What prompted this decision" },
            "decision": { "type": "string", "description": "What was decided" },
            "rationale": { "type": "string", "description": "Why this option was chosen" },
            "status": { "type": "string", "enum": ["proposed", "accepted", "deprecated", "superseded"], "description": "Decision status. Default: accepted" },
            "modules": { "type": "array", "items": { "type": "string" }, "description": "Module IDs affected" }
          },
          "required": ["title"]
        }
      }
    ],
    "chatSkills": [
      { "path": "./skills/init-sdlc/SKILL.md" },
      { "path": "./skills/plan-feature/SKILL.md" },
      { "path": "./skills/implement-task/SKILL.md" },
      { "path": "./skills/review-work/SKILL.md" },
      { "path": "./skills/log-decision/SKILL.md" }
    ],
    "chatAgents": [
      { "path": "./agents/sdlc-workflow.agent.md" }
    ],
    "chatInstructions": [
      { "path": "./prompts/sdlc-conventions.instructions.md" }
    ],
    "configuration": {
      "title": "SDLC Workflow",
      "properties": {
        "sdlc-workflow.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync SDLC data when files change"
        },
        "sdlc-workflow.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show SDLC status in the status bar"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "package": "vsce package --no-dependencies",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@syncfusion/cs-sdlc": "workspace:*",
    "preact": "^10.29.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.96.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/prompt-tsx": "^0.4.0-alpha.9",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  }
}
